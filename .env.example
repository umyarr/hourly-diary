# Example only. Never commit real values. systemd reads an external EnvironmentFile.
BOT_TOKEN=
OWNER_ID=
# Optional: owner's numeric private chat ID, equal to OWNER_ID; enables reminders before /start.
CHAT_ID=
DATA_DIR=/var/lib/hourly-diary
TIMEZONE=Europe/Moscow
# Speech recognition is disabled by default.
STT_PROVIDER=none
STT_API_KEY=
# Empty means provider default: groq=whisper-large-v3-turbo; openai=whisper-1.
STT_MODEL=
# Full HTTPS transcription URL, not a base URL. Empty uses provider default.
STT_ENDPOINT=
MAX_AUDIO_BYTES=20971520
STORAGE_LIMIT_BYTES=524288000
MAX_EXPORT_BYTES=47185920
MAX_EXPORT_DAYS=31
